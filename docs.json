{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Calseta",
  "logo": {
    "dark": "/logo/dark.png",
    "light": "/logo/light.png",
    "href": "https://calseta.com"
  },
  "favicon": "/favicon.png",
  "banner": {
    "content": "🚧 **Calseta is under active development.** APIs and features may change. We welcome feedback and contributions on [GitHub](https://github.com/calseta/calseta).",
    "dismissible": true
  },
  "colors": {
    "primary": "#4D7D71",
    "light": "#7FCAB8",
    "dark": "#01795B"
  },
  "font": {
    "headings": { "family": "Manrope" },
    "body": { "family": "IBM Plex Mono" }
  },
  "api": {
    "baseUrl": "http://localhost:8000",
    "auth": {
      "method": "bearer",
      "name": "API Key",
      "inputPrefix": "csk_"
    }
  },
  "openapi": "/openapi.json",
  "navbar": {
    "links": [
      { "label": "Website", "href": "https://calseta.com" },
      { "label": "GitHub", "href": "https://github.com/calseta/calseta" }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://docs.calseta.com/quickstart"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["quickstart"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/introduction",
              "guides/how-it-works",
              "guides/authentication",
              {
                "group": "Alert Sources",
                "pages": [
                  "guides/alert-sources/overview",
                  "guides/alert-sources/microsoft-sentinel",
                  "guides/alert-sources/elastic",
                  "guides/alert-sources/splunk",
                  "guides/alert-sources/generic-webhook"
                ]
              },
              {
                "group": "Enrichment",
                "pages": [
                  "guides/enrichment/overview",
                  "guides/enrichment/virustotal",
                  "guides/enrichment/abuseipdb",
                  "guides/enrichment/okta",
                  "guides/enrichment/entra"
                ]
              },
              "guides/detection-rules",
              "guides/context-documents",
              "guides/workflows",
              "guides/agent-webhooks",
              "guides/self-hosting"
            ]
          }
        ]
      },
      {
