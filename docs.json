{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Calseta",
  "logo": {
    "dark": "/logo/dark.png",
    "light": "/logo/light.png",
    "href": "https://calseta.com"
  },
  "favicon": "/favicon.png",
  "banner": {
    "content": "Calseta is under active development. APIs and features may change. We welcome feedback and contributions on [GitHub](https://github.com/calseta/calseta).",
    "dismissible": true
  },
  "colors": {
    "primary": "#4D7D71",
    "light": "#7FCAB8",
    "dark": "#01795B"
  },
  "font": {
    "headings": { "family": "Manrope" },
    "body": { "family": "IBM Plex Mono" }
  },
  "api": {
    "baseUrl": "http://localhost:8000",
    "auth": {
      "method": "bearer",
      "name": "API Key",
      "inputPrefix": "cai_"
    },
    "openapi": "openapi.json"
  },
  "navbar": {
    "links": [
      { "label": "Website", "href": "https://calseta.com" },
      { "label": "GitHub", "href": "https://github.com/calseta/calseta" }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://docs.calseta.com/getting-started/quickstart"
    }
  },
